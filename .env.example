# Local dev needs NONE of this — with no Supabase vars set, the app uses a
# JSON file at .data/db.json automatically. Just run `npm run dev`.
#
# For deployment (Vercel), create a Supabase project, run supabase/schema.sql
# in its SQL editor, then set these two as Vercel env vars:

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Shown as a short watermark link on saved/shared path images (see
# src/components/ShareableCard.tsx) — set this to wherever you deploy so a
# viral screenshot points back at the app. Defaults to a placeholder.
NEXT_PUBLIC_APP_URL=discobiscuits.app
